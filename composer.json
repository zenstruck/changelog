{
    "name": "zenstruck/changelog",
    "description": "Generate pretty release changelogs using the commit log and Github API.",
    "homepage": "https://github.com/zenstruck/changelog",
    "type": "library",
    "license": "MIT",
    "keywords": ["changelog", "generator"],
    "authors": [
        {
            "name": "Kevin Bond",
            "email": "kevinbond@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "composer/semver": "^3.4.3",
        "laravel-zero/phar-updater": "^1.4.2",
        "symfony/cache": "^5.4.46",
        "symfony/console": "^5.4.47",
        "symfony/filesystem": "^5.4.45",
        "symfony/http-client": "^5.4.49"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6.22",
        "symfony/phpunit-bridge": "^6.4.16",
        "symfony/var-dumper": "^5.4.48",
        "zenstruck/console-test": "^1.7"
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    },
    "autoload": {
        "psr-4": { "Zenstruck\\Changelog\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Zenstruck\\Changelog\\Tests\\": "tests/" }
    },
    "bin": ["bin/changelog"]
}
